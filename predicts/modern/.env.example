# Live tracking uses a read-only APRS-IS connection and does not require an API key.
# These defaults match the UMD CHASE/ChaseMapper connection pattern. Override
# them only when using a different APRS-IS server or login callsign.
APRSIS_SERVER=rotate.aprs2.net
APRSIS_PORT=14580
APRSIS_LOGIN_CALLSIGN=KC3SKW

# Current SondeHub-hosted Tawhiri endpoint used by BPP's existing predictor.
TAWHIRI_API_URL=https://api.v2.sondehub.org/tawhiri

# Local server settings
BPP_PREDICTS_HOST=127.0.0.1
BPP_PREDICTS_PORT=8000
