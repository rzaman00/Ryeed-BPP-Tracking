# Required only for APRS.fi live tracking.
# Create an account at https://aprs.fi and copy your API key from My Account.
APRSFI_API_KEY=
# Live callsigns are entered in the UI; the default field contains the three BPP callsigns.

# Current SondeHub-hosted Tawhiri endpoint used by BPP's existing predictor.
TAWHIRI_API_URL=https://api.v2.sondehub.org/tawhiri

# Local server settings
BPP_PREDICTS_HOST=127.0.0.1
BPP_PREDICTS_PORT=8000
