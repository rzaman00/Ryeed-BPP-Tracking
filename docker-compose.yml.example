# BPP Prediction Suite — example compose file.
# Copy to docker-compose.yml and adjust, then: docker compose up -d
# The app is then at http://<host>:8000/

services:
  bpp-predicts:
    # `:finished` tracks the finished branch. `:latest` only exists once a
    # v* release tag has been pushed.
    image: ghcr.io/rzaman00/ryeed-bpp-tracking:finished
    # To build locally instead of pulling, comment out `image:` above and
    # uncomment these two lines:
    #build:
    #  context: .
    container_name: bpp-predicts
    restart: unless-stopped

    ports:
      # host:container — change the host side if 8000 is already taken.
      - "8000:8000"

    environment:
      # Must stay 0.0.0.0 inside the container, or the port publish above
      # cannot reach it. Change the host side of `ports:` instead.
      BPP_PREDICTS_HOST: "0.0.0.0"
      BPP_PREDICTS_PORT: "8000"
      # Override only if you run your own Tawhiri instance.
      # TAWHIRI_API_URL: "https://api.v2.sondehub.org/tawhiri"
      TZ: "America/New_York"

    volumes:
      # Persists the FAA/airspace and launch-site caches across restarts and
      # image updates, so the app doesn't re-download them on every boot.
      - bpp-cache:/opt/bpp/predicts/modern/cache

    healthcheck:
      test:
        - CMD
        - python3
        - -c
        - "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"
      interval: 30s
      timeout: 10s
      start_period: 20s
      retries: 3

volumes:
  bpp-cache:
